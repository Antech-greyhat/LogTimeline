# Python bytecode and caches
__pycache__/
*.py[cod]
*.pyo

# Test / tooling caches
.pytest_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Editor / OS cruft
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Local output the tool may write (never commit real logs or results)
*.out
Output/

# IMPORTANT: never commit real logs. Only the synthetic files in Samples/
# are tracked; anything else ending in .log is ignored by default.
*.log
!Samples/*.log
